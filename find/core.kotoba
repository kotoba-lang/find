;; find/core.kotoba — org-wide recursive search for .clj/.cljc/.cljs files,
;; by extension and by content (grep), as a kbb guest on the :fs/browse-dir
;; capability (id 261). kotoba-lang/find.
;;
;; Language discipline (kbb): no loop/recur — iteration is fuel-bounded
;; self-recursion; no count-on-string — listings are walked with
;; string-index-of / string-substring; every fs-browse-dir / fs-read call is
;; inside the capability guard, so a walk cannot escape the granted tree.
;;
;; main walks a granted root directory and answers:
;;   (file-count) + 10 * (grep-count)  packed into one i64
;; where file-count = target *.clj/*.cljc/*.cljs files, grep-count = those
;; whose content contains "langchain-store.core". Packing is lossless while
;; each count stays under 10 (a job that exceeds it should switch to a
;; host-side aggregate; this first slice is a smoke slice).
(ns find.core
  (:require [kbb.browse :as browse] [kbb.fs :as fs])
  (:export [main]))

(def needle "langchain-store.core")

;; --- name predicates -----------------------------------------------------

(defn has-suffix? [name :string suf :string] :i64
  (let [n (string-byte-length name)
        m (string-byte-length suf)]
    (if (>= n m)
      (if (string=? (string-substring name (- n m) n) suf) 1 0)
      0)))

(defn is-target? [name :string] :i64
  (let [a (has-suffix? name ".clj")
        b (has-suffix? name ".cljc")
        c (has-suffix? name ".cljs")]
    (if (= 0 a)
      (if (= 0 b) c b)
      a)))

;; --- content grep -------------------------------------------------------

(defn contains-needle? [content :string] :i64
  (let [i (string-index-of content needle)]
    (if (>= i 0) 1 0)))

;; --- parse one listing line "<name>\t<0|1>" -----------------------------

;; tab position (>= 0 when the line is well-formed)
(defn line-tab [line :string] :i64
  (string-index-of line "\t"))

(defn line-name [line :string tab :i64] :string
  (string-substring line 0 tab))

(defn line-is-dir [line :string tab :i64] :i64
  (let [flag (string-substring line (+ tab 1) (string-byte-length line))]
    (if (string=? flag "1") 1 0)))

;; --- directory walk -----------------------------------------------------

;; score accumulated while scanning the CURRENT directory's own entries
;; (files scored directly; sub-directories accumulated by recursion).
;; listing is the "\n"-joined "<name>\t<0|1>" of THIS dir. acc is the score
;; of entries scanned so far. We scan line-by-line with string-index-of.
(defn scan-listing [dir :string listing :string acc :i64] :i64
  (let [n (string-byte-length listing)]
    (if (= n 0)
      acc
      (let [nl (string-index-of listing "\n")]
        (if (< nl 0)
          ;; last line
          (let [tab (line-tab listing)
                name (line-name listing tab)
                isd (line-is-dir listing tab)]
            (+ acc
               (if (string=? isd "1") 0
                   (walk-file dir name))))
          ;; a full line
          (let [rest (string-substring listing (+ nl 1) n)
                line (string-substring listing 0 nl)
                tab (line-tab line)
                name (line-name line tab)
                isd (line-is-dir line tab)
                this (if (string=? isd "1")
                       0
                       (walk-file dir name))]
            (scan-listing dir rest (+ acc this))))))))

(defn walk-file [dir :string name :string] :i64
  (let [path (string-concat (string-concat dir "/") name)
        content (fs/read-file path)]
    (+ (is-target? name)
       (* 10 (contains-needle? content)))))

;; --- main ---------------------------------------------------------------

(defn main [] :i64
  (scan-listing "test/fixtures/find_tree"
                (browse/entries-dir "test/fixtures/find_tree")
                0))